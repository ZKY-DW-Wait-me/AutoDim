<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AutoDim - AutoCAD 2025 自动尺寸标注插件
    目标框架: net8.0-windows (AutoCAD 2025 使用 .NET 8)
    平台: x64 (匹配 AutoCAD 64 位)

    引用策略: 只引用 acdbmgd + accoremgd (不引用 acmgd)。
      - acdbmgd  : DatabaseServices / Geometry / Colors (数据库与几何)
      - accoremgd: Runtime(CommandMethod) / EditorInput / ApplicationServices.Core
    这样插件既能在完整 AutoCAD 里 NETLOAD 加载, 也能在 accoreconsole 无界面测试中运行。
    引用 acmgd 会与 accoremgd 的 Application 类型产生二义性, 且无法在 core console 运行。
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <AssemblyName>AutoDim</AssemblyName>
    <RootNamespace>AutoDim</RootNamespace>

    <!-- AutoCAD 2025 安装目录。
         默认使用 D:\Program Files\AutoCAD 2025\；其他机器可通过环境变量
         ACAD_DIR 覆盖（注意需以反斜杠结尾），例如：
         ACAD_DIR="C:\Program Files\Autodesk\AutoCAD 2025\" dotnet build -->
    <AcadDir Condition="'$(ACAD_DIR)' != ''">$(ACAD_DIR)</AcadDir>
    <AcadDir Condition="'$(ACAD_DIR)' == ''">D:\Program Files\AutoCAD 2025\</AcadDir>

    <!-- 不把 AutoCAD 程序集拷贝到输出目录 -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>

    <!-- AutoCAD 托管 DLL 引用的 System.Drawing/WindowsBase/Microsoft.VisualBasic 版本高于 net8.0 引用包，
         会产生 MSB3277 版本冲突警告；插件在 AutoCAD 进程内运行，由宿主提供正确程序集，故降为消息。 -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="accoremgd">
      <HintPath>$(AcadDir)accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AcadDir)acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
